RewriteEngine On

# Redirect direct GET requests for .php files to their clean URLs.
# Non-GET requests (POST, PUT, DELETE, etc.) are excluded so API calls
# are not redirected and lose their request body/method.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the matching .php file for clean URLs.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Environment files must never be served over HTTP.
<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

# The customer-device.php endpoint is intentionally public for captive portals
# and router integrations (MAC-based heartbeat, no staff session required).
