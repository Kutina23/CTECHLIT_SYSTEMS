RewriteEngine On

# No directory listings anywhere.
Options -Indexes

# ------------------------------------------------------------------
# Block anything that is not meant to be fetched over HTTP.
# ------------------------------------------------------------------

# Version control, dotfiles (.env, .git, .htaccess …) and tooling files.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|cookies\.txt|README\.md)$ - [F,L,NC]

# Server-side code, data and logs: only PHP pages in the web root, portal/ and portal/api/ are entry points.
RewriteRule ^(config|includes|database|logs|vendor|screenshots|storage|backups?)(/|$) - [F,L,NC]

# Library files inside the API folder are included by other scripts, never called directly.
RewriteRule ^portal/api/(common|session-lifecycle)(\.php)?$ - [F,L,NC]

# Backups, dumps and logs anywhere.
RewriteRule \.(sql|sqlite|log|bak|old|orig|swp|dist|ini|sh|bat|ps1\.bak)$ - [F,L,NC]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# Clean URLs
# ------------------------------------------------------------------

# Redirect direct GET requests for .php files to their clean URLs.
# Non-GET requests (POST, PUT, DELETE, etc.) are excluded so API calls
# are not redirected and lose their request body/method.
# API endpoints are called by scripts, not typed by people, so they are never redirected.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the matching .php file for clean URLs.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# The customer-device.php endpoint is intentionally public for captive portals
# and router integrations (MAC-based heartbeat, no staff session required).

# ------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # Microphone is used by the Jarvis voice assistant; everything else is off.
    Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
    # Pages may only load code from this site and the two pinned CDNs; nothing may frame the portal.
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://assets.mixkit.co; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; frame-src 'self' https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.paystack.com; frame-ancestors 'self'"
    # HSTS only for the public HTTPS site — never for localhost or café LAN addresses, which use plain HTTP.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=(%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https') && %{HTTP_HOST} !~ /^(localhost|127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)/"
</IfModule>
