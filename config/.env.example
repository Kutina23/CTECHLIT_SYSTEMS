# ============================================================
# CTECHLIT & SYSTEMS — Environment Configuration
# Copy this file to .env and update with your actual values
# ============================================================

# Application
APP_NAME="CTECHLIT & SYSTEMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ctechlitsystems.com
APP_TIMEZONE=Africa/Accra

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ctechlit_systems
DB_USER=ctechlit_user
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Connection Pool (for high-load)
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30

# Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=86400
BCRYPT_COST=12
SESSION_LIFETIME=7200

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Email (for notifications, receipts)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ctechlitsystems.com
MAIL_FROM_NAME="CTECHLIT & SYSTEMS"

# Payment Gateways
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Caching (Redis recommended for high-load)
CACHE_DRIVER=redis
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
CACHE_TTL=3600

# Queue (for async jobs like printing, emails)
QUEUE_DRIVER=redis
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6379

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_PATH=logs/

# Backup
BACKUP_PATH=backups/
BACKUP_RETENTION_DAYS=30

# AI Assistant (OpenAI-compatible API)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-3.5-turbo

# Station agent (LAN hardware control). Use the same key in each station's setup-agent.ps1 -ApiKey.
STATION_AGENT_API_KEY=generate_a_long_random_station_agent_key
STATION_AGENT_PORT=8080
# Optional extra Wake-on-LAN broadcast addresses, comma separated (e.g. 192.168.1.255)
WOL_BROADCAST_ADDRESSES=
# auto | lan | cloud. "cloud" = server hosted online: commands go through the agents' HTTPS
# check-ins and Wake-on-LAN/device checks are relayed by an online café PC. "auto" detects it.
DEVICE_CONTROL_MODE=auto
# Public address stations use to reach the server (used in downloaded installers), e.g.
# https://ctechlitsystems.com/systems — leave empty to use the address you browse the portal on.
AGENT_SERVER_URL=

# Jarvis speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
JARVIS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
JARVIS_TTS_MODEL_ID=eleven_multilingual_v2
